{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "super-pedidos-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // La API vive en su propio subdominio; Cloudflare crea el DNS y el certificado al publicar.
  // Va en el primer nivel (no api.supercoquin...) porque el certificado gratuito de
  // Cloudflare solo cubre *.christopherpineda.com.
  "routes": [{ "pattern": "supercoquin-api.christopherpineda.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "super-pedidos",
      "database_id": "65a3badd-bc40-4c3e-9ef1-26ff1e57ec35",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Sitios web que pueden llamar a la API, separados por coma.
    "ORIGENES_PERMITIDOS": "https://supercoquin.christopherpineda.com,http://localhost:8081"
  }
}
